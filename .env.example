# Telegram Bot Configuration
# Get your BOT_TOKEN from Telegram's @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Telegram Channel or Group Chat ID to broadcast signals automatically (e.g. -100123456789 or @your_channel)
TELEGRAM_CHANNEL_ID=

# Bot Settings
POLLING_INTERVAL_MINUTES=15
MIN_RISK_REWARD=2.0
RISK_PER_TRADE_PERCENT=1.0
